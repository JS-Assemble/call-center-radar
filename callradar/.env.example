# Gemini free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Paths (defaults assume repo-relative data/ layout)
CALLRADAR_DB_PATH=callradar.db
CALLRADAR_AUDIO_DIR=data/audio
CALLRADAR_METADATA_DIR=data/metadata
CALLRADAR_WORK_DIR=.callradar_work

# HuggingFace cache — kept inside the repo. On locked-down machines the
# default (~/.cache/huggingface) can be write-restricted for spawned
# processes; this dodges that instead of fighting permissions.
HF_HOME=.hf_cache

# Pipeline
CALLRADAR_ASR_MODEL=base.en
CALLRADAR_ASR_COMPUTE_TYPE=int8
CALLRADAR_ASR_WORKERS=3

# A sentence is dropped as a likely hallucination if its average per-word
# confidence falls below this — catches tail artifacts (e.g. a segment-level
# confidence check missed "You should." at avg ~0.31 word-probability, buried
# inside an otherwise-confident 40s segment) without discarding legitimate
# quiet content (a mumbled "4.45 p.m." stays well clear at avg ~0.65).
CALLRADAR_ASR_MIN_WORD_CONFIDENCE=0.45

# s4 dead-air signal — a gap counts only if it's this long AND both channels'
# RMS energy stays below the threshold (distinguishes real silence from
# quiet/untranscribed speech in the gap). Calibrated against ~0.06 real-speech
# RMS and ~0.02 channel noise-floor RMS in a small real-audio sample.
CALLRADAR_DEAD_AIR_MIN_GAP_S=2.0
CALLRADAR_DEAD_AIR_RMS_THRESHOLD=0.03

# Evidence gate
CALLRADAR_QUOTE_MATCH_THRESHOLD=90
CALLRADAR_TIMESTAMP_TOLERANCE_S=0.5
CALLRADAR_MAX_RETRIES=2

# Dashboard "as-of" default — leave blank to default to corpus max(call_date)
CALLRADAR_AS_OF_DATE=


